# ===================================================================
# FinMan Environment Variables Template (.env.example)
# Sao chép file này thành .env ở thư mục gốc (root) và điền các giá trị thực tế:
# cp .env.example .env
# ===================================================================

# JWT Security (Chuỗi bảo mật JWT tối thiểu 256 bits)
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_here
JWT_EXPIRATION_MS=604800000

# Google Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finman
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
